//! V10.13: test ciblé de mise à jour des textes du GameSpeedMenuItem natif.
//! Pointeur capturé à l'ouverture du menu; aucun parcours de la capacité inutilisée.
use core::ffi::c_void;
use std::sync::atomic::{AtomicUsize, Ordering};
use unity::prelude::*;
use unity::system::List;
use engage::menu::{ConfigMenu, config::ConfigBasicMenuItem};

static CREATE_CALLS: AtomicUsize = AtomicUsize::new(0);
static NATIVE_GAMESPEED: AtomicUsize = AtomicUsize::new(0);

// Offsets confirmés dans les bindings IL2CPP pour FE Engage v2.0.0.
#[skyline::from_offset(0x250c220)]
fn game_speed_set_command_text(this: *mut c_void, method_info: *const c_void);

#[skyline::from_offset(0x250c390)]
fn game_speed_set_help_text(this: *mut c_void, method_info: *const c_void);

#[skyline::hook(offset = 0x253a470)]
fn config_sequence_create_config_menu(this: *mut c_void, method_info: *const c_void) {
    NATIVE_GAMESPEED.store(0, Ordering::Relaxed);
    let n = CREATE_CALLS.fetch_add(1, Ordering::Relaxed) + 1;
    original!()(this, method_info);
    if this.is_null() { return; }
    unsafe {
        let child = ((this as *const u8).add(0x38) as *const *const c_void).read();
        if child.is_null() { return; }
        let menu = &*(child as *const ConfigMenu<()>);
        let menu_class = format!("{:?}", menu.get_class().get_name());
        if menu_class != r#""ConfigMenu""# && menu_class != r#"Some("ConfigMenu")"# { return; }
        let full = ((child as *const u8).add(0x80) as *const *const List<ConfigBasicMenuItem>).read();
        if full.is_null() { return; }
        let list = &*full;
        let size = list.len();
        let capacity = list.capacity();
        if size <= 3 || size > capacity || size > 128 {
            skyline::println!("[ELP V10.13] invalid native list size={} capacity={}", size, capacity);
            return;
        }
        // Position observée et classe vérifiée dans la V10.12.
        let entry = match list.iter().take(size).nth(3) {
            Some(entry) => entry,
            None => return,
        };
        let class_name = format!("{:?}", entry.get_class().get_name());
        if class_name != r#""GameSpeedMenuItem""# && class_name != r#"Some("GameSpeedMenuItem")"# {
            skyline::println!("[ELP V10.13] item #3 unexpected class={}", class_name);
            return;
        }
        let ptr = *entry as *const ConfigBasicMenuItem;
        if ptr.is_null() { return; }
        NATIVE_GAMESPEED.store(ptr as usize, Ordering::Relaxed);
        skyline::println!("[ELP V10.13] CREATE #{} GameSpeedMenuItem captured ptr={:p} list_size={}", n, ptr, size);
    }
}

/// À appeler sur le thread du menu, immédiatement après reload_messages().
pub fn refresh_native_gamespeed() {
    let ptr = NATIVE_GAMESPEED.load(Ordering::Relaxed) as *mut ConfigBasicMenuItem;
    if ptr.is_null() {
        skyline::println!("[ELP V10.13] refresh skipped: native GameSpeedMenuItem not captured");
        return;
    }
    unsafe {
        let item = &mut *ptr;
        let class_name = format!("{:?}", item.get_class().get_name());
        if class_name != r#""GameSpeedMenuItem""# && class_name != r#"Some("GameSpeedMenuItem")"# {
            skyline::println!("[ELP V10.13] refresh skipped: unexpected class={}", class_name);
            NATIVE_GAMESPEED.store(0, Ordering::Relaxed);
            return;
        }
        skyline::println!("[ELP V10.13] GameSpeed command BEFORE={:?}", item.command_text.get_string());
        game_speed_set_command_text(ptr.cast(), core::ptr::null());
        game_speed_set_help_text(ptr.cast(), core::ptr::null());
        skyline::println!("[ELP V10.13] GameSpeed command AFTER={:?}", item.command_text.get_string());
        item.update_text();
        skyline::println!("[ELP V10.13] GameSpeed UpdateText complete");
    }
}

pub fn install() {
    skyline::println!("[ELP V10.13] Installing targeted native GameSpeed refresh");
    skyline::install_hooks!(config_sequence_create_config_menu);
}
